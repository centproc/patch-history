@page "/"
@inject HttpClient Http
@inject NavigationManager Nav

<PageTitle>Patch Notes - Home</PageTitle>

<div class="home-hero">
<h3>Search for a specific game for their patch notes history</h3>

  <div class="search-wrap">
    <input @bind="Query" @bind:event="oninput"
           placeholder="Search games…"
           class="search-input" />

    @if (showDropdown)
    {
      <ul class="search-dropdown">
        @if (filtered.Count == 0)
        {
          <li class="empty">No matches</li>
        }
        else
        {
          @foreach (var g in filtered)
          {
            <li>
              <button type="button"
                      class="result"
                      @onclick="@(() => GoTo($"/docs/{g.Slug}"))">
                <span class="title">@g.Title</span>
                @*<span class="slug">@g.Slug</span>*@
              </button>
            </li>
          }
        }
      </ul>
    }
  </div>
</div>

@code {
  private List<Game> games = new();
  private List<Game> filtered = new();
  private string query = string.Empty;
  private bool showDropdown;

  protected override async Task OnInitializedAsync()
  {
    games = await Http.GetFromJsonAsync<List<Game>>("docs/toc.json") ?? new();
  }

  private string Query
  {
    get => query;
    set { query = value; Filter(); }
  }

  private void Filter()
  {
    var q = (query ?? string.Empty).Trim();
    showDropdown = q.Length > 0;
    if (!showDropdown) { filtered.Clear(); return; }

    filtered = games
      .Where(g => g.Title.Contains(q, StringComparison.OrdinalIgnoreCase)
               || g.Slug.Contains(q, StringComparison.OrdinalIgnoreCase))
      .OrderBy(g => g.Title)
      .Take(8)
      .ToList();
  }

  private void GoTo(string relative)
  {
    var url = $"{Nav.BaseUri.TrimEnd('/')}{relative}";
    Nav.NavigateTo(url);
  }

  private class Game { public string Title { get; set; } = ""; public string Slug { get; set; } = ""; }
}